# Copy this file to .env.local and fill in the values.

# MongoDB connection string (MongoDB Atlas or a local instance)
# e.g. mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/bytespace?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign login sessions (JWT). Generate one with:
#   openssl rand -base64 32
# If left empty, a secret is derived from MONGODB_URI (fine for a demo, set your own for real use).
AUTH_SECRET=
